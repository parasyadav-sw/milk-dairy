datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id               Int              @id @default(autoincrement())
  email            String           @unique
  username         String?          @unique
  password         String
  name             String
  role             String
  status           String           @default("ACTIVE")
  
  routesCreated    Route[]          @relation("AdminRoutes")
  routesAssigned   Route[]          @relation("EmployeeRoutes")
  milkCollections  MilkCollection[] @relation("CollectedBy")
  payments         Payment[]        @relation("ProcessedBy")
  attendance       Attendance[]
  leaves           Leave[]          @relation("EmployeeLeaves")
  approvedLeaves   Leave[]          @relation("ApprovedBy")
  notifications    Notification[]
  auditLogs        AuditLog[]
  registeredFarmers Farmer[]
  surveysSubmitted Survey[]          @relation("EmployeeSurveys")
  
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
}

model Farmer {
  id              String           @id // Custom ID like "FMR-XXXX"
  name            String
  mobile          String
  altMobile       String?
  gender          String
  age             Int
  aadhaar         String?
  village         String
  taluka          String
  district        String
  address         String
  gpsLocation     String?
  animalType      String           // "COW", "BUFFALO", "BOTH"
  cowCount        Int              @default(0)
  buffaloCount    Int              @default(0)
  totalAnimals    Int              @default(0)
  cowMilkYield    Float            @default(0.0)
  buffaloMilkYield Float           @default(0.0)
  
  surveyDate      String?
  notes           String?

  registeredById  Int
  registeredBy    User             @relation(fields: [registeredById], references: [id])
  
  milkCollections MilkCollection[]
  payments        Payment[]
  
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
}

model Route {
  id                 Int      @id @default(autoincrement())
  name               String
  description        String?
  village            String
  
  adminId            Int
  admin              User     @relation("AdminRoutes", fields: [adminId], references: [id])
  
  assignedEmployeeId Int?
  assignedEmployee   User?    @relation("EmployeeRoutes", fields: [assignedEmployeeId], references: [id])
  
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}



model MilkCollection {
  id             Int      @id @default(autoincrement())
  
  date           String   // "YYYY-MM-DD"
  timeOfDay      String   // "MORNING", "EVENING"
  quantityLitres Float
  fatPercent     Float
  snfPercent     Float
  clr            Float?
  ratePerLitre   Float
  totalAmount    Float
  
  collectedById  Int
  collectedBy    User     @relation("CollectedBy", fields: [collectedById], references: [id])
  
  farmerId       String
  farmer         Farmer   @relation(fields: [farmerId], references: [id])
  
  paymentStatus  String   @default("PENDING") // "PENDING", "PAID"
  paymentId      Int?
  payment        Payment? @relation(fields: [paymentId], references: [id])
  
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Payment {
  id             Int              @id @default(autoincrement())
  farmerId       String
  farmer         Farmer           @relation(fields: [farmerId], references: [id])
  
  amount         Float
  paymentDate    String           // "YYYY-MM-DD"
  status         String           // "COMPLETED", "FAILED"
  transactionRef String?
  
  processedById  Int
  processedBy    User             @relation("ProcessedBy", fields: [processedById], references: [id])
  
  milkCollections MilkCollection[]
  
  createdAt      DateTime         @default(now())
}

model Attendance {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
  
  date      String   // "YYYY-MM-DD"
  status    String   // "PRESENT", "ABSENT", "LEAVE"
  clockIn   String?  // "HH:MM"
  clockOut  String?  // "HH:MM"
  
  createdAt DateTime @default(now())

  @@unique([userId, date])
}

model Leave {
  id            Int      @id @default(autoincrement())
  userId        Int
  user          User     @relation("EmployeeLeaves", fields: [userId], references: [id])
  
  startDate     String   // "YYYY-MM-DD"
  endDate       String   // "YYYY-MM-DD"
  reason        String
  status        String   @default("PENDING") // "PENDING", "APPROVED", "REJECTED"
  
  approvedById  Int?
  approvedBy    User?    @relation("ApprovedBy", fields: [approvedById], references: [id])
  
  createdAt     DateTime @default(now())
}

model Notification {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
  
  title     String
  message   String
  read      Boolean  @default(false)
  
  createdAt DateTime @default(now())
}

model AuditLog {
  id        Int      @id @default(autoincrement())
  userId    Int?
  user      User?    @relation(fields: [userId], references: [id])
  
  action    String
  details   String
  timestamp DateTime @default(now())
}

model Survey {
  id                  Int      @id @default(autoincrement())
  customerName        String
  mobile              String
  village             String
  address             String
  animals             String     // Serialized JSON string of [{type: 'COW'|'BUFFALO', count: number, milkPerAnimal: number}]
  totalAnimals        Int
  totalMilkProduction Float
  interested          Boolean  @default(false)
  remarks             String?
  employeeId          Int
  employee            User     @relation("EmployeeSurveys", fields: [employeeId], references: [id])
  surveyDate          String   // "YYYY-MM-DD"
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}
