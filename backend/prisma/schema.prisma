datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  ADMIN
  MANAGER
  EMPLOYEE
}

model User {
  id               Int              @id @default(autoincrement())
  email            String           @unique
  password         String
  name             String
  role             Role
  status           String           @default("ACTIVE")
  
  // Self-relation for manager-employee hierarchy
  managerId        Int?
  manager          User?            @relation("ManagerEmployees", fields: [managerId], references: [id])
  employees        User[]           @relation("ManagerEmployees")

  routesCreated    Route[]          @relation("ManagerRoutes")
  routesAssigned   Route[]          @relation("EmployeeRoutes")
  visits           Visit[]          @relation("EmployeeVisits")
  managedVisits    Visit[]          @relation("ManagerVisits")
  milkCollections  MilkCollection[] @relation("CollectedBy")
  payments         Payment[]        @relation("ProcessedBy")
  attendance       Attendance[]
  leaves           Leave[]          @relation("EmployeeLeaves")
  approvedLeaves   Leave[]          @relation("ApprovedBy")
  notifications    Notification[]
  auditLogs        AuditLog[]
  registeredFarmers Farmer[]
  
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
}

model Farmer {
  id              String           @id // Custom ID like "FMR-XXXX"
  name            String
  mobile          String
  altMobile       String?
  gender          String
  age             Int
  aadhaar         String?
  village         String
  taluka          String
  district        String
  address         String
  gpsLocation     String?
  animalType      String           // "COW", "BUFFALO", "BOTH"
  cowCount        Int              @default(0)
  buffaloCount    Int              @default(0)
  totalAnimals    Int              @default(0)

  registeredById  Int
  registeredBy    User             @relation(fields: [registeredById], references: [id])
  
  visits          Visit[]
  milkCollections MilkCollection[]
  payments        Payment[]
  
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
}

model Route {
  id                 Int      @id @default(autoincrement())
  name               String
  description        String?
  village            String
  
  managerId          Int
  manager            User     @relation("ManagerRoutes", fields: [managerId], references: [id])
  
  assignedEmployeeId Int?
  assignedEmployee   User?    @relation("EmployeeRoutes", fields: [assignedEmployeeId], references: [id])
  
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model Visit {
  id            Int              @id @default(autoincrement())
  date          String           // "YYYY-MM-DD"
  time          String           // "HH:MM"
  
  employeeId    Int
  employee      User             @relation("EmployeeVisits", fields: [employeeId], references: [id])
  
  managerId     Int
  manager       User             @relation("ManagerVisits", fields: [managerId], references: [id])
  
  farmerId      String
  farmer        Farmer           @relation(fields: [farmerId], references: [id])
  
  remarks       String?
  nextVisitDate String?
  gpsLocation   String?
  status        String           // "PENDING", "COMPLETED", "CANCELLED"
  photos        String?          // Comma-separated image paths or URLs
  
  milkCollections MilkCollection[]
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
}

model MilkCollection {
  id             Int      @id @default(autoincrement())
  visitId        Int?
  visit          Visit?   @relation(fields: [visitId], references: [id])
  
  date           String   // "YYYY-MM-DD"
  timeOfDay      String   // "MORNING", "EVENING"
  quantityLitres Float
  fatPercent     Float
  snfPercent     Float
  clr            Float?
  ratePerLitre   Float
  totalAmount    Float
  
  collectedById  Int
  collectedBy    User     @relation("CollectedBy", fields: [collectedById], references: [id])
  
  farmerId       String
  farmer         Farmer   @relation(fields: [farmerId], references: [id])
  
  paymentStatus  String   @default("PENDING") // "PENDING", "PAID"
  paymentId      Int?
  payment        Payment? @relation(fields: [paymentId], references: [id])
  
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Payment {
  id             Int              @id @default(autoincrement())
  farmerId       String
  farmer         Farmer           @relation(fields: [farmerId], references: [id])
  
  amount         Float
  paymentDate    String           // "YYYY-MM-DD"
  status         String           // "COMPLETED", "FAILED"
  transactionRef String?
  
  processedById  Int
  processedBy    User             @relation("ProcessedBy", fields: [processedById], references: [id])
  
  milkCollections MilkCollection[]
  
  createdAt      DateTime         @default(now())
}

model Attendance {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
  
  date      String   // "YYYY-MM-DD"
  status    String   // "PRESENT", "ABSENT", "LEAVE"
  clockIn   String?  // "HH:MM"
  clockOut  String?  // "HH:MM"
  
  createdAt DateTime @default(now())
}

model Leave {
  id            Int      @id @default(autoincrement())
  userId        Int
  user          User     @relation("EmployeeLeaves", fields: [userId], references: [id])
  
  startDate     String   // "YYYY-MM-DD"
  endDate       String   // "YYYY-MM-DD"
  reason        String
  status        String   @default("PENDING") // "PENDING", "APPROVED", "REJECTED"
  
  approvedById  Int?
  approvedBy    User?    @relation("ApprovedBy", fields: [approvedById], references: [id])
  
  createdAt     DateTime @default(now())
}

model Notification {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
  
  title     String
  message   String
  read      Boolean  @default(false)
  
  createdAt DateTime @default(now())
}

model AuditLog {
  id        Int      @id @default(autoincrement())
  userId    Int?
  user      User?    @relation(fields: [userId], references: [id])
  
  action    String
  details   String
  timestamp DateTime @default(now())
}
