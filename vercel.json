{
  "buildCommand": "npm run build:frontend",
  "outputDirectory": "frontend/dist",
  "rewrites": [
    { "source": "/api/(.*)", "destination": "https://milk-dairy-backend-1p5s.onrender.com/api/$1" },
    { "source": "/uploads/(.*)", "destination": "https://milk-dairy-backend-1p5s.onrender.com/uploads/$1" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
