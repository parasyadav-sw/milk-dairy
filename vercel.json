{
  "buildCommand": "npm run build:frontend",
  "outputDirectory": "frontend/dist",
  "cleanUrls": true,
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://milk-dairy-backend-1p5s.onrender.com/api/:path*" },
    { "source": "/uploads/:path*", "destination": "https://milk-dairy-backend-1p5s.onrender.com/uploads/:path*" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
